rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Games root collection
    match /games/{gameId} {
      allow read, write: if true;

      match /wordBank/{docId} {
        allow read, write: if true;
      }

      match /teams/{teamId} {
        allow read, write: if true;

        match /members/{memberId} {
          allow read, write: if true;
        }
      }

      match /rounds/{roundId} {
        allow read, write: if true;
      }

      // Host secret word collection (anti-cheat protected)
      match /hostSecrets/{roundId} {
        allow read: if request.auth != null;
        allow write: if true;
      }
    }
  }
}
